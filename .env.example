# ============================================================
# IMAGIAX — Variables de entorno requeridas
#
# Copia este archivo como .env.production en el servidor y rellena
# los valores reales. NUNCA commitear .env.production a git.
# ============================================================

# ── PostgreSQL ────────────────────────────────────────────────────────────────
# URL completa de conexión para asyncpg (FastAPI)
POSTGRES_URL=postgresql://imagiax:CAMBIA_ESTO@postgres:5432/imagiax

# Password para el contenedor PostgreSQL (docker-compose)
# Debe coincidir con la contraseña en POSTGRES_URL
POSTGRES_PASSWORD=CAMBIA_ESTO

# ── JWT / Autenticación ───────────────────────────────────────────────────────
# Clave secreta para firmar tokens JWT. OBLIGATORIO en producción.
# Genera una clave fuerte con: python3 -c "import secrets; print(secrets.token_hex(48))"
JWT_SECRET=CAMBIA_ESTO_GENERA_CLAVE_ALEATORIA_48_BYTES_HEX

# Duración de los tokens en horas (default: 24)
JWT_EXPIRE_HOURS=24

# Límite de intentos de login fallidos antes de bloquear (default: 5 intentos en 5 min)
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=300

# ── Admin inicial ─────────────────────────────────────────────────────────────
# Si no existe ningún superadmin al arrancar, se crea automáticamente con estos datos.
# Cambia la contraseña INMEDIATAMENTE tras el primer login.
IMAGIAX_ADMIN_EMAIL=admin@imagiax.dev
IMAGIAX_ADMIN_PASSWORD=CAMBIA_ESTO_MINIMO_8_CHARS
IMAGIAX_ADMIN_NAME=Administrador IMAGIAX

# ── Orthanc PACS ──────────────────────────────────────────────────────────────
ORTHANC_BASE_URL=http://orthanc:8042
ORTHANC_USER=imagiax
# IMPORTANTE: este valor se inyecta en orthanc.json.template via envsubst al
# arrancar el contenedor Orthanc (ver orthanc-entrypoint.sh).
# Genera una contraseña fuerte: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
ORTHANC_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE

# ── Google Gemini ─────────────────────────────────────────────────────────────
GEMINI_API_KEY=AIzaSy...CAMBIA_ESTO

# ── Branding de clínica ───────────────────────────────────────────────────────
IMAGIAX_BRAND_NAME=Clínica IMAGIAX
IMAGIAX_BRAND_SUBTITLE=Radiología con Inteligencia Artificial
IMAGIAX_DOCTOR_NAME=Dr. Nombre Apellido
IMAGIAX_DOCTOR_SPECIALTY=Médico Radiólogo
IMAGIAX_DOCTOR_LICENSE=12345

# URL pública de la aplicación (para links en informes, webhooks, etc.)
IMAGIAX_BASE_URL=https://imagiax.dev
IMAGIAX_VIEWER_URL=https://imagiax.dev

# Precio del informe en CLP (default: 990)
# IMAGIAX_PRECIO_SCAN=990

# ── Pagos — MercadoPago ───────────────────────────────────────────────────────
# Obtén tus credenciales en https://www.mercadopago.cl/developers/panel
MP_ACCESS_TOKEN=APP_USR-...CAMBIA_ESTO
MP_PUBLIC_KEY=APP_USR-...CAMBIA_ESTO
MP_WEBHOOK_SECRET=CAMBIA_ESTO_SECRETO_WEBHOOK

# ── Pagos — Transbank Webpay OneClick ────────────────────────────────────────
# Entorno: "integration" (pruebas) o "production"
TBK_ENVIRONMENT=production
TBK_MALL_COMMERCE_CODE=597055555541
TBK_CHILD_COMMERCE_CODE=597055555542

# ── Opcionales ────────────────────────────────────────────────────────────────
# Timeout HTTP en segundos para llamadas a Orthanc/Gemini (default: 30)
# IMAGIAX_HTTP_TIMEOUT=30
